# Copy to .env and fill in. Never commit real values.

# Neon Postgres — pooled URL for the app, direct (non "-pooler") URL for Prisma migrations
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth — secret: `openssl rand -base64 32`; URL: the site origin
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional — the button appears only when both are set).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# QPay merchant API v2 — credentials and invoice code from QPay (support@qpay.mn).
# Sandbox: https://merchant-sandbox.qpay.mn · Production: https://merchant.qpay.mn
QPAY_BASE_URL="https://merchant-sandbox.qpay.mn"
QPAY_CLIENT_ID=""
QPAY_CLIENT_SECRET=""
QPAY_INVOICE_CODE=""

# Public site URL (used for the QPay callback URL in production)
NEXT_PUBLIC_SITE_URL="https://www.milliongoats.mn"

# QPay test accounts. Comma-separated user ids (the "user".id column), not emails:
# sign-up does not verify emails.
# Their orders show the real price but QPay invoices ask for 100₮.
QPAY_TEST_USER_IDS=""

# Admin (/admin sales page)
ADMIN_USER_IDS=""

# Vercel Cron: daily purge of expired unpaid orders (/api/cron/purge-orders)
CRON_SECRET=""
# WeSend (https://wesend.mn) API key for Premium installment emails. Without it
# no emails are sent. Sandbox keys (ws_test_…) send nothing.
WESEND_API_KEY=""

# Telegram signal bot (/api/telegram/webhook). Admins write a signal to the bot,
# confirm it, and the bot copies it to the private channel. After setting these
# (locally and on Vercel), deploy and run `pnpm telegram:setup`.
# Token from @BotFather. Add the bot to the channel as an admin with "Post messages".
TELEGRAM_BOT_TOKEN=""
# Any random string of A-Z a-z 0-9 _ -: `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=""
# The channel's numeric id (-100…). Forward a channel post to @userinfobot to see it.
TELEGRAM_CHANNEL_ID=""
# Telegram user ids allowed to post signals, comma-separated. Send /start to the bot to see yours.
TELEGRAM_ADMIN_IDS=""
