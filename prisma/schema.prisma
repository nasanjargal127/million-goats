generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth (generated with @better-auth/cli, keep in sync) ───────────

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  orders        Order[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Events, seats and QPay orders ─────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  venue       String
  /// Empty for ongoing offerings such as the Trading Lab.
  startsAt    DateTime?
  /// Price of one seat in MNT (₮).
  priceMnt    Int
  /// Seat map layout: rows are lettered A, B, C…; seats numbered 1…seatsPerRow.
  rowCount    Int
  seatsPerRow Int
  /// Draw an aisle after this seat number (e.g. 6 → gap between 6 and 7).
  aisleAfter  Int?
  published   Boolean   @default(true)
  /// Shown on /events. The Trading Lab is booked from /lab instead.
  listed      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  seats       Seat[]
  orders      Order[]

  @@map("event")
}

enum SeatStatus {
  AVAILABLE
  /// Held for a pending order until heldUntil; free again afterwards.
  HELD
  SOLD
}

model Seat {
  id        String     @id @default(cuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  row       String
  number    Int
  status    SeatStatus @default(AVAILABLE)
  heldUntil DateTime?
  orderId   String?
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([eventId, row, number])
  @@index([orderId])
  @@map("seat")
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  /// Paid after the hold expired and the seats went to someone else: refund manually.
  REFUND_REQUIRED
  /// Installment order: the first part is paid and the seat is held until balanceDueAt.
  DEPOSIT_PAID
  /// Installment order whose balance was not paid by balanceDueAt: the seat was
  /// released and the first part is kept.
  BALANCE_UNPAID
}

enum OrderKind {
  SEAT
  MERCH
}

/// Trading Lab package bought with a seat (prices in src/lib/lab/packages.ts).
enum LabPackage {
  PRO
  PREMIUM
}

model Order {
  id                   String          @id @default(cuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                 OrderKind       @default(SEAT)
  /// Set for seat orders.
  eventId              String?
  event                Event?          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status               OrderStatus     @default(PENDING)
  amountMnt            Int
  /// What the QPay invoice actually asks for. Equals amountMnt, except for
  /// test accounts (QPAY_TEST_USER_IDS), which are charged TEST_CHARGE_MNT.
  chargedMnt           Int?
  /// Snapshot of the seat labels, e.g. ["B-5", "B-6"].
  seatLabels           String[]
  /// Merch orders: what was bought, e.g. "Traders Dept. футболк · L × 2".
  itemLabel            String?
  variantId            String?
  variant              ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity             Int?
  contactPhone         String?
  /// Trading Lab seat orders: the package, the Pro teacher and the Pro add-on.
  /// itemLabel holds the readable snapshot, e.g. "Pro багц · Багш 2 · Сэтгэлзүйч".
  labPackage           LabPackage?
  teacher              String?
  withPsychologist     Boolean         @default(false)
  /// Installment orders (Premium in two parts) only: the price of the first part.
  /// The balance is amountMnt - depositMnt and is due by balanceDueAt.
  depositMnt           Int?
  balanceDueAt         DateTime?
  /// The paid first-part invoice. Once it is paid, the qpay* fields below are
  /// cleared and later hold the balance invoice.
  depositChargedMnt    Int?
  depositInvoiceId     String?
  depositPaymentId     String?
  depositPaidAt        DateTime?
  /// When the "first part received" email went out (see installment-emails.ts).
  depositEmailSentAt   DateTime?
  /// Balance reminder emails sent so far: 1 = a week before, 2 = the last day.
  balanceRemindersSent Int             @default(0)
  expiresAt            DateTime
  qpayInvoiceId        String?         @unique
  qpayQrText           String?
  qpayQrImage          String?
  qpayShortUrl         String?
  /// Bank app deep links returned by QPay: [{ name, description, logo, link }].
  qpayUrls             Json?
  qpayPaymentId        String?
  checkedAt            DateTime?
  paidAt               DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  seats                Seat[]

  @@index([userId])
  @@index([eventId])
  @@map("order")
}

// ─── Merch ─────────────────────────────────────────────────────────────────

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  /// Price of one item in MNT (₮).
  priceMnt    Int
  /// Path under /public, e.g. "/merch/traders-dept-tee.jpg".
  imagePath   String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]

  @@map("product")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  sortOrder Int     @default(0)
  orders    Order[]

  @@unique([productId, size])
  @@map("product_variant")
}

// ─── Telegram signals ──────────────────────────────────────────────────────

enum SignalStatus {
  /// Recorded, not yet picked up for sending.
  DRAFT
  /// Claimed by one sender (first delivery or a Retry press); guards against
  /// double posting.
  SENDING
  SENT
  /// Telegram refused or was unreachable; the admin can retry.
  FAILED
  CANCELLED
}

/// A message an admin wrote to the bot, copied to the private channel as-is
/// (text, formatting, photo + caption) straight away.
model Signal {
  id               String       @id @default(cuid())
  status           SignalStatus @default(DRAFT)
  /// The admin's private chat with the bot and their message in it.
  sourceChatId     String
  sourceMessageId  Int
  /// The bot's reply reporting the outcome (link, or error + Retry).
  promptMessageId  Int?
  adminName        String?
  /// Start of the text or caption, for history.
  preview          String?
  channelMessageId Int?
  attempts         Int          @default(0)
  error            String?
  sentAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  /// Telegram may deliver the same update twice: one message, one signal.
  @@unique([sourceChatId, sourceMessageId])
  @@map("signal")
}
